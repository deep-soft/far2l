+// deep-soft: permissions in octal, always 4 digits (0644, 4755); blank when the mode is unknown
+const FARString FormatStr_AttributeOctal(DWORD UnixMode, int Width)
+{
+	FormatString strResult;
+	wchar_t OutStr[8] = {L' ', L' ', L' ', L' ', 0};
+	if (UnixMode != 0) {
+		const DWORD Perm = UnixMode & 07777;
+		OutStr[0] = L'0' + ((Perm >> 9) & 7);
+		OutStr[1] = L'0' + ((Perm >> 6) & 7);
+		OutStr[2] = L'0' + ((Perm >> 3) & 7);
+		OutStr[3] = L'0' + (Perm & 7);
+	}
+
+	if (Width > 0)
+		strResult << fmt::Size(Width);
+
+	strResult << OutStr;
+	return std::move(strResult.strValue());
+}
